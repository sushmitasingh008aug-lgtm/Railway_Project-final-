# Universal .env — works on Windows/Linux/macOS without port conflicts
# Host ports fixed to 8765 (app → container 3000) and 5433 (postgres → container 5432)
# Verified free 2026-08-26: ss -tulpn shows 3000/5432 taken by old stack, 8765/5433 free (no LISTEN, not in common dev use)
# Copy to .env: cp .env.example .env — docker-compose auto-loads it
POSTGRES_DB=block_planning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/block_planning?sslmode=disable
POSTGRES_URI=postgresql://postgres:postgrespassword@postgres:5432/block_planning?sslmode=disable
PORT=8765
HORIZON_DAYS=7
PYTHON_BIN=python3
PYTHONUNBUFFERED=1
VITE_API_URL=/api
